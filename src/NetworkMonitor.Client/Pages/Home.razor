@page "/"
@inherits BlazorStateComponent
@implements IAsyncDisposable
@inject NavigationManager Nav

<PageTitle>Network Monitor</PageTitle>

<header class="topbar">
    <div class="brand">
        <span class="logo">◉</span>
        <div>
            <h1>Network Monitor</h1>
            <p class="subtitle">Connection honeypot &middot; listening on @State.PortLabel</p>
        </div>
    </div>
    <div class="status">
        <span class="dot @(State.Live ? "dot-on" : "dot-off")"></span>
        <span>@(State.Live ? "Live" : "Disconnected")</span>
        <span class="total">@State.Rows.Count shown / @State.Total total</span>
        <form method="post" action="logout" class="signout">
            <button type="submit" class="btn btn-clear">Sign out</button>
        </form>
    </div>
</header>

<section class="stats">
    @foreach (var stat in State.PortStats.OrderByDescending(s => s.Count))
    {
        <button class="chip @(State.PortFilter == stat.Port ? "chip-active" : "")"
                @onclick="() => Dispatch(new ConnectionsState.TogglePortFilterAction { Port = stat.Port })">
            <span class="chip-port">@stat.Service</span>
            <span class="chip-count">@stat.Count</span>
        </button>
    }
</section>

<section class="controls">
    <input class="search" placeholder="Filter by IP…" value="@State.IpFilter"
           @oninput="e => Dispatch(new ConnectionsState.SetIpFilterAction { Value = e.Value?.ToString() ?? string.Empty })" />
    <input class="search" placeholder="Search summary / service…" value="@State.TextFilter"
           @oninput="e => Dispatch(new ConnectionsState.SetTextFilterAction { Value = e.Value?.ToString() ?? string.Empty })" />
    <label class="pause">
        <input type="checkbox" checked="@State.Paused"
               @onchange="e => Dispatch(new ConnectionsState.SetPausedAction { Paused = (bool)(e.Value ?? false) })" />
        Pause live updates
    </label>
    <button class="btn" @onclick="() => Dispatch(new ConnectionsState.LoadConnectionsAction())">Reload</button>
    @if (State.PortFilter is not null || State.IpFilter.Length > 0 || State.TextFilter.Length > 0)
    {
        <button class="btn btn-clear" @onclick="() => Dispatch(new ConnectionsState.ClearFiltersAction())">Clear filters</button>
    }
</section>

<div class="layout">
    <section class="table-wrap">
        <table class="log">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Service</th>
                    <th>Port</th>
                    <th>Source</th>
                    <th>Summary</th>
                    <th class="num">Bytes</th>
                </tr>
            </thead>
            <tbody>
                @if (!State.FilteredRows.Any())
                {
                    <tr><td colspan="6" class="empty">No connections captured yet. Waiting for traffic…</td></tr>
                }
                @foreach (var c in State.FilteredRows)
                {
                    <tr class="@(State.SelectedId == c.Id ? "row-selected" : "") @(c.HasCredentials ? "row-cred" : "")"
                        @onclick="() => Dispatch(new ConnectionsState.SelectConnectionAction { Id = c.Id })">
                        <td class="mono">@c.StartedAt.LocalDateTime.ToString("HH:mm:ss")</td>
                        <td><span class="svc svc-@c.Transport.ToLower()">@c.Service</span></td>
                        <td class="mono">@c.Transport/@c.Port</td>
                        <td class="mono">@c.RemoteIp:@c.RemotePort</td>
                        <td class="summary">
                            @if (c.HasCredentials)
                            {
                                <span class="key">🔑</span>
                            }
                            @c.Summary
                        </td>
                        <td class="num mono">@c.BytesReceived</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <aside class="detail @(State.SelectedDetail is null ? "detail-empty" : "")">
        @if (State.SelectedDetail is { } d)
        {
            <div class="detail-head">
                <h2>@d.Service <small>@d.Transport/@d.Port</small></h2>
                <button class="btn-close" @onclick="() => Dispatch(new ConnectionsState.ClearSelectionAction())">✕</button>
            </div>

            <dl class="meta">
                <dt>Source</dt><dd class="mono">@d.RemoteIp : @d.RemotePort</dd>
                <dt>Started</dt><dd class="mono">@d.StartedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                <dt>Duration</dt><dd class="mono">@d.DurationSeconds.ToString("0.00") s</dd>
                <dt>Bytes in / out</dt><dd class="mono">@d.BytesReceived / @d.BytesSent</dd>
            </dl>

            @if (d.Credentials.Count > 0)
            {
                <h3>Credentials offered</h3>
                <table class="creds">
                    <thead><tr><th>Service</th><th>Username</th><th>Password</th><th>Method</th></tr></thead>
                    <tbody>
                        @foreach (var cred in d.Credentials)
                        {
                            <tr>
                                <td>@cred.Service</td>
                                <td class="mono">@(cred.Username ?? "—")</td>
                                <td class="mono">@(cred.Password ?? "—")</td>
                                <td>@cred.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (d.Notes.Count > 0)
            {
                <h3>Protocol transcript</h3>
                <pre class="notes">@string.Join("\n", d.Notes)</pre>
            }

            @if (!string.IsNullOrEmpty(d.HexDump))
            {
                <h3>Raw bytes (hex)</h3>
                <pre class="hex">@d.HexDump</pre>
            }
        }
        else if (State.SelectedId is not null)
        {
            <p class="hint">Loading…</p>
        }
        else
        {
            <p class="hint">Select a connection to see everything the peer sent — the full transcript, any credentials tried, and a hex dump of the raw bytes.</p>
        }
    </aside>
</div>

@code {
    private ConnectionsState State => GetState<ConnectionsState>();

    private HubConnection? _hub;

    /// <summary>Dispatches an action to the store.</summary>
    private Task Dispatch(IAction action) => Mediator.Send(action);

    protected override async Task OnInitializedAsync()
    {
        await Dispatch(new ConnectionsState.InitializeAction());
        await ConnectHubAsync();
    }

    private async Task ConnectHubAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri(HubContract.Path))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<ConnectionEventDto>(HubContract.ConnectionRecorded, dto =>
            InvokeAsync(() => Dispatch(new ConnectionsState.ConnectionReceivedAction { Dto = dto })));

        _hub.Reconnected += _ => InvokeAsync(() => Dispatch(new ConnectionsState.SetLiveAction { Live = true }));
        _hub.Closed += _ => InvokeAsync(() => Dispatch(new ConnectionsState.SetLiveAction { Live = false }));

        try
        {
            await _hub.StartAsync();
            await Dispatch(new ConnectionsState.SetLiveAction { Live = true });
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Nav.NavigateTo("login", forceLoad: true);
        }
        catch { await Dispatch(new ConnectionsState.SetLiveAction { Live = false }); }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
            await _hub.DisposeAsync();
        Dispose(); // BlazorStateComponent.Dispose() unsubscribes from the store.
    }
}
