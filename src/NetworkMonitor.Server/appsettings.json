{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Dashboard": {
    "Url": "http://0.0.0.0:8099"
  },
  "Monitor": {
    "BindAddress": "0.0.0.0",
    "DatabasePath": "networkmonitor.db",
    "HistoryPageSize": 500,
    "Limits": {
      "MaxBytesPerConnection": 16384,
      "IdleTimeoutSeconds": 30,
      "MaxConnectionSeconds": 120,
      "MaxConnectionsPerIp": 20,
      "MaxConcurrentConnections": 500
    },
    "TcpPorts": [
      { "Port": 21, "Service": "FTP", "Handler": "ftp" },
      { "Port": 22, "Service": "SSH", "Handler": "ssh" },
      { "Port": 23, "Service": "Telnet", "Handler": "telnet" },
      { "Port": 25, "Service": "SMTP", "Handler": "smtp" },
      { "Port": 80, "Service": "HTTP", "Handler": "http" },
      { "Port": 110, "Service": "POP3", "Handler": "pop3" },
      { "Port": 143, "Service": "IMAP", "Handler": "imap" },
      { "Port": 443, "Service": "HTTPS", "Handler": "https" },
      { "Port": 445, "Service": "SMB", "Handler": "raw" },
      { "Port": 1433, "Service": "MSSQL", "Handler": "raw" },
      { "Port": 3306, "Service": "MySQL", "Handler": "raw" },
      { "Port": 3389, "Service": "RDP", "Handler": "raw" },
      { "Port": 5432, "Service": "PostgreSQL", "Handler": "raw" },
      { "Port": 5900, "Service": "VNC", "Handler": "raw" },
      { "Port": 6379, "Service": "Redis", "Handler": "redis" },
      { "Port": 8080, "Service": "HTTP-alt", "Handler": "http" },
      { "Port": 27017, "Service": "MongoDB", "Handler": "raw" }
    ],
    "UdpPorts": [
      { "Port": 53, "Service": "DNS" },
      { "Port": 123, "Service": "NTP" },
      { "Port": 161, "Service": "SNMP" }
    ]
  }
}
